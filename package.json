{
  "name": "sam-compiler",
  "private": true,
  "version": "0.6.0",
  "description": "SAM Compiler - Syntax Analysis Machine IDE with cloud-native execution.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w @sam/api",
    "start:api": "npm start -w @sam/api",
    "start:worker": "npm start -w @sam/worker",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w @sam/api\" \"npm run dev -w @sam/worker\" \"npm run dev -w @sam/web\"",
    "build": "npm run build -ws --if-present",
    "build:web": "npm run build -w @sam/web",
    "build:api": "npm run build -w @sam/api",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
