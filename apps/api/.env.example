PORT=8080
NODE_ENV=development
MONGO_URI=mongodb://root:rootpassword@localhost:27017/sam?authSource=admin
REDIS_URL=redis://localhost:6379

# CORS — comma-separated exact origins. Matching is exact; an unset value
# fails closed rather than allowing every origin.
# The Vite dev server runs on 5174 (apps/web/vite.config.js).
WEB_ORIGIN=http://localhost:5174

# Auth
# Minimum 32 characters — validated at import time, the API will not boot otherwise.
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# AI assistant (apps/api/src/modules/ai)
# REQUIRED: the API refuses to start without a Gemini key.
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=
# Optional, comma-separated; enables OpenAI in the provider rotation.
OPENAI_API_KEYS=

# Social Login (OAuth)
# Get these from GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For local development: http://localhost:8080/api/auth
CALLBACK_URL_BASE=http://localhost:8080/api/auth

# Outbound email for password resets. Without these, reset emails are not sent
# and the API logs a warning (it never logs the reset link itself).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: upper bound on the cloud sandbox call, in ms (default 30000)
JUDGE0_TIMEOUT_MS=30000
