# Copy to .env in the repo root before running `docker compose up`.
# docker compose reads this automatically; it is gitignored.

# --- Datastores ---
MONGO_USER=root
MONGO_PASSWORD=change-me-before-you-run-this

# --- API ---
# Must be at least 32 characters (enforced in apps/api/src/config/env.js).
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Required: the API refuses to boot without it.
GEMINI_API_KEY=your-gemini-api-key
# Optional, comma-separated, used for provider rotation.
OPENAI_API_KEYS=

# --- Origins ---
WEB_ORIGIN=http://localhost
VITE_API_URL=http://localhost:8080

# --- Email (optional) ---
# Without these, password-reset emails are not sent and the API logs a warning.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
